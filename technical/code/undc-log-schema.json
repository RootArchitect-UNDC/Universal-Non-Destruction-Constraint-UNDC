{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UNDC Log Schema",
  "description": "Immutable log entry for the Universal Non-Destruction Constraint (UNDC) framework",
  "type": "object",
  "required": [
    "log_version",
    "timestamp",
    "anchor_hash",
    "verification_status",
    "event_type",
    "event_data",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "log_version": {
      "type": "string",
      "description": "Version of the UNDC log format",
      "pattern": "^v[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of the log entry",
      "format": "date-time"
    },
    "anchor_hash": {
      "type": "string",
      "description": "Cryptographic hash anchoring the log entry",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verification_status": {
      "type": "string",
      "description": "OpenTimestamps verification status",
      "enum": ["VERIFIED", "PENDING", "FAILED"]
    },
    "event_type": {
      "type": "string",
      "description": "Type of event being logged",
      "enum": [
        "SUBMISSION",
        "REVIEW",
        "AUDIT",
        "INCIDENT",
        "COMPLIANCE_CHECK"
      ]
    },
    "event_data": {
      "type": "object",
      "description": "Event-specific data",
      "additionalProperties": true
    },
    "signature": {
      "type": "string",
      "description": "Digital signature of the log entry",
      "pattern": "^[a-f0-9]{128}$"
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata",
      "additionalProperties": true,
      "properties": {
        "source": {
          "type": "string",
          "description": "Source of the log entry"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes"
        }
      }
    }
  }
}
