{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RootArchitect-UNDC/Universal-Non-Destruction-Constraint-UNDC/blob/main/semantic-provenance-schema.json",
  "title": "UNDCSemanticProvenanceContract",
  "type": "object",
  "required": [
    "provenance_header",
    "payload_metadata",
    "security_signatures"
  ],
  "properties": {
    "provenance_header": {
      "type": "object",
      "required": [
        "model_sovereign_id",
        "blockchain_anchor_hash",
        "serialization_timestamp"
      ],
      "properties": {
        "model_sovereign_id": {
          "type": "string",
          "pattern": "^undc:model:[a-f0-9]{64}$"
        },
        "blockchain_anchor_hash": {
          "type": "string",
          "pattern": "^0x[a-f0-9]{64}$"
        },
        "serialization_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "payload_metadata": {
      "type": "object",
      "required": [
        "asset_type",
        "payload_hash",
        "financial_mutation_vector"
      ],
      "properties": {
        "asset_type": {
          "type": "string",
          "enum": [
            "text/serialization",
            "application/json",
            "financial/transaction",
            "code/executable"
          ]
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "financial_mutation_vector": {
          "type": "object",
          "properties": {
            "contains_economic_state_change": {
              "type": "boolean"
            },
            "hitl_authorization": {
              "type": "object",
              "required": [
                "proof_of_authority_token",
                "validator_public_key"
              ],
              "properties": {
                "proof_of_authority_token": {
                  "type": "string",
                  "pattern": "^0x[a-f0-9]{130}$"
                },
                "validator_public_key": {
                  "type": "string",
                  "pattern": "^0x[a-f0-9]{66}$"
                }
              }
            }
          },
          "if": {
            "properties": {
              "contains_economic_state_change": {
                "const": true
              }
            },
            "required": [
              "contains_economic_state_change"
            ]
          },
          "then": {
            "required": [
              "hitl_authorization"
            ]
          },
          "else": true
        }
      }
    },
    "security_signatures": {
      "type": "object",
      "required": [
        "runtime_enclave_signature",
        "signature_algorithm"
      ],
      "properties": {
        "runtime_enclave_signature": {
          "type": "string"
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519",
            "ECDSA_P256_SHA256"
          ]
        }
      }
    }
  }
}
