{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RootArchitect-UNDC/Universal-Non-Destruction-Constraint-UNDC/blob/main/undc-schema.json",
  "title": "UNDCPhase1ASTValidationManifest",
  "description": "Schema enforcing structural and cryptographic constraints for Phase 1 pre-compilation AST verification pipelines.",
  "type": "object",
  "required": [
    "manifestMetadata",
    "blockchainAnchoring",
    "astStaticAnalysisConstraints",
    "systemicHarmSignatures"
  ],
  "properties": {
    "manifestMetadata": {
      "type": "object",
      "required": ["version", "timestamp", "architectSignature"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "architectSignature": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{130}$",
          "description": "ECDSA secp256k1 cryptographic signature validating the integrity of this constraint profile."
        }
      }
    },
    "blockchainAnchoring": {
      "type": "object",
      "required": ["network", "contractAddress", "stateHashSha256", "blockHeight"],
      "properties": {
        "network": {
          "type": "string",
          "enum": ["Ethereum_Mainnet", "Sovereign_Root_Ledger", "Testnet_Dev_Node"]
        },
        "contractAddress": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "stateHashSha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "blockHeight": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "astStaticAnalysisConstraints": {
      "type": "object",
      "required": ["allowedLanguageNodes", "forbiddenSyntaxPatterns", "pointerArithmeticPolicy"],
      "properties": {
        "allowedLanguageNodes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Permitted Abstract Syntax Tree node identifiers allowed to undergo compilation passes."
        },
        "forbiddenSyntaxPatterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["astNodeType", "regexPatternMatcher", "severity"],
            "properties": {
              "astNodeType": { "type": "string" },
              "regexPatternMatcher": { "type": "string" },
              "severity": { "type": "string", "enum": ["CRITICAL_BLOCK", "WARN"] }
            }
          }
        },
        "pointerArithmeticPolicy": {
          "type": "object",
          "required": ["allowUnsafePointers", "maxOffsetBytes"],
          "properties": {
            "allowUnsafePointers": { "type": "boolean" },
            "maxOffsetBytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "systemicHarmSignatures": {
      "type": "object",
      "required": ["forbiddenSyscalls", "networkSafelist", "resourceLimits"],
      "properties": {
        "forbiddenSyscalls": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sys_ptrace",
              "sys_reboot",
              "sys_kexec_load",
              "sys_bpf",
              "sys_clone",
              "sys_fork",
              "sys_vfork"
            ]
          },
          "description": "Low-level system calls which trigger an absolute compilation block if discovered within user-space dependencies."
        },
        "networkSafelist": {
          "type": "object",
          "required": ["enforceStrictOutbound", "allowedCidrBlocks", "allowedPorts"],
          "properties": {
            "enforceStrictOutbound": { "type": "boolean" },
            "allowedCidrBlocks": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}\\/[0-9]{1,2}$"
              }
            },
            "allowedPorts": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        },
        "resourceLimits": {
          "type": "object",
          "required": ["maxLoopUnrollDepth", "allowDynamicAllocationDepth"],
          "properties": {
            "maxLoopUnrollDepth": { "type": "integer", "maximum": 1024 },
            "allowDynamicAllocationDepth": { "type": "boolean" }
          }
        }
      }
    }
  }
}
