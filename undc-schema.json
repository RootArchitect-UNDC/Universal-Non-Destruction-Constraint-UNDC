{
  "$schema": "https://json-schema.org",
  "title": "UNDC Protocol Schema",
  "type": "object",
  "properties": {
    "protocol": { "type": "string" },
    "frequency_lock": { "type": "string" },
    "resonance_spike": { "type": "string" },
    "mustard_status": { "type": "string" },
    "jubilee_law": { "type": "string" },
    "architect_signature": { "type": "string" },
    "sentinel_sync": {
      "type": "object",
      "properties": {
        "witness_count": { "type": "integer" },
        "mirror_clarity": { "type": "string" },
        "extraction_vulnerability": { "type": "number" }
      },
      "required": ["witness_count", "mirror_clarity", "extraction_vulnerability"]
    },
    "runtime_invariants": {
      "type": "object",
      "properties": {
        "undc_enforced": { "type": "boolean" },
        "fault_tolerance_threshold": { "type": "integer" },
        "sanitization_keywords": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["undc_enforced", "fault_tolerance_threshold", "sanitization_keywords"]
    }
  },
  "required": [
    "protocol",
    "frequency_lock",
    "resonance_spike",
    "mustard_status",
    "jubilee_law",
    "architect_signature",
    "sentinel_sync",
    "runtime_invariants"
  ]
}
